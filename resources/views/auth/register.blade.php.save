            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: #f3f4f6;
            font-family: Arial, sans-serif;
            color: #1f2937;
        }

        .register-container {
            width: 100%;
            max-width: 420px;
            padding: 36px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.07);
        }

        .register-header {
            margin-bottom: 28px;
            text-align: center;
        }

        .register-header h1 {
            margin: 0 0 10px;
            font-size: 26px;
        }

        .register-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            font-size: 15px;
        }

        input:focus {
            outline: 2px solid #9ca3af;
            outline-offset: 1px;
        }

        .button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 7px;
            background: #374151;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .button:hover {
            background: #1f2937;
        }

        .links {
            margin-top: 22px;
            text-align: center;
            font-size: 14px;
        }

        .links a {
            color: #374151;
            text-decoration: none;
        }

        .links a:hover {
            text-decoration: underline;
        }

        .error {
            margin-top: 7px;
            color: #b91c1c;
            font-size: 13px;
        }

        .status {
            margin-bottom: 20px;
            padding: 12px;
            border-radius: 7px;
            background: #ecfdf5;
            color: #065f46;
            font-size: 14px;
        }

        @media (max-width: 480px) {
            .register-container {
